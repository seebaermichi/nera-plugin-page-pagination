{
    "name": "@nera-static/plugin-page-pagination",
    "version": "2.3.0",
    "description": "A plugin for Nera static site generator to create previous/next page pagination within directory structures. Perfect for blog posts, documentation sections, and sequential content navigation.",
    "main": "index.js",
    "scripts": {
        "publish-template": "node ./bin/publish-template.js",
        "lint": "eslint .",
        "test": "vitest",
        "prepare": "husky"
    },
    "type": "module",
    "exports": {
        ".": "./index.js"
    },
    "files": [
        "bin",
        "config",
        "index.js",
        "views",
        "CHANGELOG.md"
    ],
    "keywords": [
        "nera",
        "plugin",
        "pagination",
        "previous-next",
        "page-navigation",
        "static-site",
        "static-site-generator",
        "sequential-navigation",
        "blog-pagination",
        "documentation"
    ],
    "author": "Michael Becker",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/seebaermichi/nera-plugin-page-pagination"
    },
    "bugs": {
        "url": "https://github.com/seebaermichi/nera-plugin-page-pagination/issues"
    },
    "homepage": "https://github.com/seebaermichi/nera-plugin-page-pagination#readme",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@nera-static/plugin-utils": "^1.2.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "cheerio": "^1.1.0",
        "eslint": "^9.31.0",
        "husky": "^9.1.7",
        "pug": "^3.0.3",
        "vitest": "^3.2.4"
    },
    "sideEffects": false,
    "bin": {
        "nera-page-pagination": "./bin/publish-template.js"
    }
}
